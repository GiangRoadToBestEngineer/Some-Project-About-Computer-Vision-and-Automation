import cv2
from ultralytics import YOLO

# 1. Tải model YOLO Pose siêu nhẹ (~6.7 MB)
model = YOLO("yolov8n-pose.pt")

# 2. Mở Camera & giảm độ phân giải xuống 320x240 để Pi chạy mượt
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 320)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 240)

print("--- Đang chạy YOLO Pose trên Thonny ---")

while True:
    ret, frame = cap.read()
    if not ret:
        print("Không đọc được Camera!")
        break

    # 3. Nhận diện khung xương
    results = model(frame, verbose=False)

    # 4. Vẽ điểm khớp & khung xương lên ảnh
    annotated_frame = results[0].plot()

    # 5. Hiển thị lên màn hình
    cv2.imshow("YOLO Pose HDMI", annotated_frame)

    # Bấm phím 'q' để thoát
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
