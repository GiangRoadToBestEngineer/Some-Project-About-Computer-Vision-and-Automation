import cv2
import numpy as np
import onnxruntime as ort
from picam2 import Picamera2
import threading
import time

# ---------------------------------------------------------
# 1. CẤU HÌNH MÔ HÌNH VÀ ONNX RUNTIME
# ---------------------------------------------------------
MODEL_PATH = "yolo26n.onnx"
AI_SIZE = 640  # Khớp chuẩn 640x640 của mô hình

opts = ort.SessionOptions()
opts.intra_op_num_threads = 4
opts.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
opts.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL

print("Đang nạp mô hình AI...")
session = ort.InferenceSession(MODEL_PATH, opts, providers=['CPUExecutionProvider'])
input_name = session.get_inputs()[0].name
output_name = session.get_outputs()[0].name

# Khởi tạo Pi Camera
print("Đang mở Pi Camera...")
picam2 = Picamera2()
config = picam2.create_preview_configuration(main={"size": (640, 480)})
picam2.configure(config)
picam2.start()

# Các biến dùng chung giữa các luồng (Shared Variables)
latest_frame = None
frame_lock = threading.Lock()
boxes_lock = threading.Lock()

shared_boxes = []
shared_fall_detected = False
is_running = True

# ---------------------------------------------------------
# 2. LUỒNG CHẠY AI NGẦM (BACKGROUND AI THREAD)
# ---------------------------------------------------------
def ai_worker():
    global shared_boxes, shared_fall_detected, is_running
    
    while is_running:
        # Lấy khung hình mới nhất từ luồng chính
        with frame_lock:
            if latest_frame is None:
                time.sleep(0.01)
                continue
            frame_to_process = latest_frame.copy()

        h_orig, w_orig = frame_to_process.shape[:2]

        # Tiền xử lý
        img_resized = cv2.resize(frame_to_process, (AI_SIZE, AI_SIZE))
        img_rgb = cv2.cvtColor(img_resized, cv2.COLOR_BGR2RGB)
        input_tensor = img_rgb.astype(np.float32) / 255.0
        input_tensor = np.transpose(input_tensor, (2, 0, 1))
        input_tensor = np.expand_dims(input_tensor, axis=0)

        # Suy luận AI ngầm (Không làm ảnh hưởng luồng hiển thị)
        outputs = session.run([output_name], {input_name: input_tensor})
        preds = np.squeeze(outputs[0])

        current_boxes = []
        scores_list = []

        if preds.ndim == 2 and preds.shape[1] == 6:  # End-to-End
            for pred in preds:
                x1_ai, y1_ai, x2_ai, y2_ai, score, class_id = pred
                if int(class_id) == 0 and score > 0.40:
                    bw = int((x2_ai - x1_ai) * (w_orig / float(AI_SIZE)))
                    bh = int((y2_ai - y1_ai) * (h_orig / float(AI_SIZE)))
                    x1 = int(x1_ai * (w_orig / float(AI_SIZE)))
                    y1 = int(y1_ai * (h_orig / float(AI_SIZE)))
                    current_boxes.append([x1, y1, bw, bh])
                    scores_list.append(float(score))
            indices = list(range(len(current_boxes)))
        else:  # Raw Output
            if preds.shape[0] == 84:
                preds = preds.T
            person_scores = preds[:, 4]
            mask = person_scores > 0.40
            valid_preds = preds[mask]
            valid_scores = person_scores[mask]

            for pred, score in zip(valid_preds, valid_scores):
                cx, cy, w, h = pred[0], pred[1], pred[2], pred[3]
                bw = int(w * (w_orig / float(AI_SIZE)))
                bh = int(h * (h_orig / float(AI_SIZE)))
                x1 = int((cx - w / 2) * (w_orig / float(AI_SIZE)))
                y1 = int((cy - h / 2) * (h_orig / float(AI_SIZE)))
                current_boxes.append([x1, y1, bw, bh])
                scores_list.append(float(score))

            nms_out = cv2.dnn.NMSBoxes(current_boxes, scores_list, score_threshold=0.40, nms_threshold=0.5)
            indices = nms_out.flatten() if len(nms_out) > 0 else []

        # Kiểm tra điều kiện té ngã
        new_boxes = [current_boxes[i] for i in indices]
        fall = False
        for (x1, y1, w, h) in new_boxes:
            if w > h:
                fall = True
                break

        # Cập nhật kết quả sang luồng chính
        with boxes_lock:
            shared_boxes = new_boxes
            shared_fall_detected = fall

# Kích hoạt luồng AI chạy song song
ai_thread = threading.Thread(target=ai_worker, daemon=True)
ai_thread.start()

# ---------------------------------------------------------
# 3. LUỒNG CHÍNH: LẤY ẢNH VÀ HIỂN THỊ CỰC MƯỢT (MAIN LOOP)
# ---------------------------------------------------------
print("Hệ thống đã sẵn sàng! Bấm 'q' để thoát.")

while True:
    frame_rgb = picam2.capture_array()
    frame = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2BGR)
    h_orig, w_orig = frame.shape[:2]

    # Cập nhật khung hình mới cho luồng AI
    with frame_lock:
        latest_frame = frame.copy()

    # Lấy tọa độ Bounding Box mới nhất từ luồng AI
    with boxes_lock:
        boxes = list(shared_boxes)
        fall_detected = shared_fall_detected

    annotated_frame = frame.copy()

    # Vẽ kết quả lên khung hình hiển thị
    for (x1, y1, w, h) in boxes:
        x2, y2 = x1 + w, y1 + h
        x1, y1 = max(0, x1), max(0, y1)
        x2, y2 = min(w_orig, x2), min(h_orig, y2)

        A, B, C, D = (x1, y1), (x2, y1), (x2, y2), (x1, y2)
        AB = x2 - x1
        AD = y2 - y1

        is_lying = AB > AD
        box_color = (0, 0, 255) if is_lying else (0, 255, 0)

        cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), box_color, 2)
        cv2.putText(annotated_frame, "A", (A[0] - 10, A[1] - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)
        cv2.putText(annotated_frame, "B", (B[0] + 5, B[1] - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)
        cv2.putText(annotated_frame, "C", (C[0] + 5, C[1] + 15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)
        cv2.putText(annotated_frame, "D", (D[0] - 10, D[1] + 15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)
        cv2.putText(annotated_frame, f"AB={AB}px, AD={AD}px", (x1, max(20, y1 - 10)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)

    # Hiển thị cảnh báo báo động đỏ
    if fall_detected:
        cv2.rectangle(annotated_frame, (0, 0), (w_orig, h_orig), (0, 0, 255), 10)
        cv2.putText(annotated_frame, "BAO DONG DO: CANH AB > AD (TE NGA)!", (10, 35),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.imshow("Raspberry Pi 3B+ - Smooth Threaded Fall Detection", annotated_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        is_running = False
        break

picam2.stop()
cv2.destroyAllWindows()
