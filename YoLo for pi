import cv2
import numpy as np
import onnxruntime as ort
from picamera2 import Picamera2
import threading
import time

# ---------------------------------------------------------
# 1. Danh sách 80 lớp vật thể COCO (Tiếng Việt)
# ---------------------------------------------------------
CLASSES = [
    "Nguoi", "Xe dap", "O to", "Xe may", "May bay", "Xe bus", "Tau hoa", "Xe tai", "Thuyen", "Den giao thong",
    "Cot nuoc PCCC", "Bien Stop", "Dong ho do xe", "Ghe dai", "Chim", "Meo", "Cho", "Ngua", "Cuu", "Bo",
    "Voi", "Gau", "Ngua van", "Huou cao co", "Balo", "O/Du", "Tui xach", "Ca vat", "Vali", "Dia bay",
    "Van truot tuyet", "Gay truot tuyet", "Bong", "Dieu", "Gay bong chay", "Gang tay bong chay", "Van truot", "Van luot song",
    "Vot tennis", "Chai/Lo", "Ly ruou", "Coc/Ly", "Nia", "Dao", "Muong", "Bat/To", "Chuoi", "Tao",
    "Banh mi kep", "Cam", "Bong cai xanh", "Ca rot", "Xuc xich", "Pizza", "Banh donut", "Banh ngot", "Ghe", "Ghe sofa",
    "Cay canh", "Giuong", "Ban an", "Bon cau", "Tivi", "Laptop", "Chuot", "Dieu khien", "Ban phim", "Dien thoai",
    "Lo vi meo", "Lo nuong", "May nuong banh", "Bon rua", "Tu lanh", "Sach", "Dong ho", "Binh hoa", "Keo", "Gau bong",
    "May say toc", "Ban chai"
]

# ID của Giường (Giuong = 59) và Ghế sofa (Ghe sofa = 57) trong mảng COCO
BED_SOFA_IDS = [57, 59]

# Màu cố định cho từng vật thể
np.random.seed(42)
COLORS = np.random.randint(50, 255, size=(len(CLASSES), 3), dtype=np.uint8)

# ---------------------------------------------------------
# 2. CẤU HÌNH MÔ HÌNH VÀ ONNX RUNTIME
# ---------------------------------------------------------
MODEL_PATH = "yolo26n.onnx"  # Hoặc yolov8n.onnx
AI_SIZE = 640

opts = ort.SessionOptions()
opts.intra_op_num_threads = 4
opts.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
opts.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL

print(f"Đang nạp mô hình: {MODEL_PATH}...")
session = ort.InferenceSession(MODEL_PATH, opts, providers=['CPUExecutionProvider'])
input_name = session.get_inputs()[0].name
output_name = session.get_outputs()[0].name

# Khởi tạo Pi Camera
print("Đang mở Pi Camera...")
picam2 = Picamera2()
config = picam2.create_preview_configuration(main={"size": (640, 480)})
picam2.configure(config)
picam2.start()

# Biến dùng chung giữa các luồng
latest_frame = None
frame_lock = threading.Lock()
data_lock = threading.Lock()

shared_results = []
is_running = True

# Hàm tính tỉ lệ đè phủ (Overlap) giữa hai Bounding Box
def calculate_overlap(box_person, box_furniture):
    # box format: [x1, y1, x2, y2]
    xA = max(box_person[0], box_furniture[0])
    yA = max(box_person[1], box_furniture[1])
    xB = min(box_person[2], box_furniture[2])
    yB = min(box_person[3], box_furniture[3])

    inter_area = max(0, xB - xA) * max(0, yB - yA)
    if inter_area == 0:
        return 0.0

    person_area = (box_person[2] - box_person[0]) * (box_person[3] - box_person[1])
    return inter_area / float(person_area) if person_area > 0 else 0.0

# ---------------------------------------------------------
# 3. LUỒNG XỬ LÝ AI VÀ NGHĨA NGỮ CẢNH (BACKGROUND THREAD)
# ---------------------------------------------------------
def ai_worker():
    global shared_results, is_running

    while is_running:
        with frame_lock:
            if latest_frame is None:
                time.sleep(0.01)
                continue
            frame_to_process = latest_frame.copy()

        h_orig, w_orig = frame_to_process.shape[:2]

        # Tiền xử lý ảnh
        img_resized = cv2.resize(frame_to_process, (AI_SIZE, AI_SIZE))
        img_rgb = cv2.cvtColor(img_resized, cv2.COLOR_BGR2RGB)
        input_tensor = img_rgb.astype(np.float32) / 255.0
        input_tensor = np.transpose(input_tensor, (2, 0, 1))
        input_tensor = np.expand_dims(input_tensor, axis=0)

        outputs = session.run([output_name], {input_name: input_tensor})
        preds = np.squeeze(outputs[0])

        boxes = []
        scores = []
        class_ids = []

        # Parse output [N, 6] hoặc [84, 8400]
        if preds.ndim == 2 and preds.shape[1] == 6:
            for pred in preds:
                x1_ai, y1_ai, x2_ai, y2_ai, score, cid = pred
                if score > 0.35:
                    bw = int((x2_ai - x1_ai) * (w_orig / float(AI_SIZE)))
                    bh = int((y2_ai - y1_ai) * (h_orig / float(AI_SIZE)))
                    x1 = int(x1_ai * (w_orig / float(AI_SIZE)))
                    y1 = int(y1_ai * (h_orig / float(AI_SIZE)))
                    boxes.append([x1, y1, bw, bh])
                    scores.append(float(score))
                    class_ids.append(int(cid))
            indices = list(range(len(boxes)))
        else:
            if preds.shape[0] == 84:
                preds = preds.T
            scores_matrix = preds[:, 4:]
            c_ids = np.argmax(scores_matrix, axis=1)
            max_scores = np.max(scores_matrix, axis=1)

            mask = max_scores > 0.35
            valid_preds = preds[mask]
            valid_scores = max_scores[mask]
            valid_ids = c_ids[mask]

            for pred, score, cid in zip(valid_preds, valid_scores, valid_ids):
                cx, cy, w, h = pred[0], pred[1], pred[2], pred[3]
                bw = int(w * (w_orig / float(AI_SIZE)))
                bh = int(h * (h_orig / float(AI_SIZE)))
                x1 = int((cx - w / 2) * (w_orig / float(AI_SIZE)))
                y1 = int((cy - h / 2) * (h_orig / float(AI_SIZE)))
                boxes.append([x1, y1, bw, bh])
                scores.append(float(score))
                class_ids.append(int(cid))

            nms_out = cv2.dnn.NMSBoxes(boxes, scores, score_threshold=0.35, nms_threshold=0.45)
            indices = nms_out.flatten() if len(nms_out) > 0 else []

        # Tách danh sách giường/sofa và danh sách người
        furniture_boxes = []
        raw_detections = []

        for idx in indices:
            x1, y1, w, h = boxes[idx]
            x2, y2 = min(w_orig, x1 + w), min(h_orig, y1 + h)
            x1, y1 = max(0, x1), max(0, y1)
            cid = class_ids[idx]
            sc = scores[idx]

            raw_detections.append({
                'box': [x1, y1, x2, y2],
                'class_id': cid,
                'score': sc
            })

            if cid in BED_SOFA_IDS:
                furniture_boxes.append([x1, y1, x2, y2])

        # Phân tích logic AB > AD kết hợp Ngữ cảnh đè Bed/Sofa
        final_results = []
        for det in raw_detections:
            x1, y1, x2, y2 = det['box']
            cid = det['class_id']
            sc = det['score']

            if cid == 0:  # Class "Nguoi"
                AB = x2 - x1  # Chiều rộng
                AD = y2 - y1  # Chiều cao
                is_horizontal = AB > AD

                status = 0  # 0: Bình thường (Đứng/Ngồi)
                if is_horizontal:
                    # Kiểm tra xem có nằm đè lên giường hay sofa không (> 30% diện tích)
                    on_furniture = False
                    for f_box in furniture_boxes:
                        overlap = calculate_overlap([x1, y1, x2, y2], f_box)
                        if overlap > 0.30:
                            on_furniture = True
                            break

                    if on_furniture:
                        status = 1  # 1: Nằm trên Giường/Sofa (AN TOÀN)
                    else:
                        status = 2  # 2: TÉ NGÃ DƯỚI SÀN (BÁO ĐỘNG ĐỎ)

                final_results.append({
                    'type': 'person',
                    'box': [x1, y1, x2, y2],
                    'AB': AB,
                    'AD': AD,
                    'status': status,
                    'score': sc
                })
            else:  # Vật thể khác (Bàn, ghế, tivi, laptop, giường, sofa...)
                final_results.append({
                    'type': 'object',
                    'box': [x1, y1, x2, y2],
                    'class_id': cid,
                    'score': sc
                })

        with data_lock:
            shared_results = final_results

# Kích hoạt luồng AI
ai_thread = threading.Thread(target=ai_worker, daemon=True)
ai_thread.start()

# ---------------------------------------------------------
# 4. LUỒNG CHÍNH: HIỂN THỊ CỰC MƯỢT TRÊN MÀN HÌNH
# ---------------------------------------------------------
print("Hệ thống Robot Quét Ngữ Cảnh + Té Ngã sẵn sàng! Bấm 'q' để thoát.")

while True:
    frame_rgb = picam2.capture_array()
    frame = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2BGR)
    h_orig, w_orig = frame.shape[:2]

    with frame_lock:
        latest_frame = frame.copy()

    with data_lock:
        results = list(shared_results)

    annotated_frame = frame.copy()
    real_fall_detected = False

    for item in results:
        x1, y1, x2, y2 = item['box']

        if item['type'] == 'person':
            AB = item['AB']
            AD = item['AD']
            status = item['status']

            # Quy định màu sắc và nhãn người
            if status == 2:      # Té ngã dưới sàn
                color = (0, 0, 255)      # Đỏ
                label = f"TE NGA DUS SAN! (AB={AB}px, AD={AD}px)"
                real_fall_detected = True
            elif status == 1:    # Nằm trên Giường / Sofa
                color = (0, 165, 255)    # Cam
                label = f"Nam Giuong/Sofa - An Toan (AB={AB}px, AD={AD}px)"
            else:                # Đứng / Ngồi
                color = (0, 255, 0)      # Xanh lá
                label = f"Nguoi (AB={AB}px, AD={AD}px)"

            # Vẽ Bounding Box người
            cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), color, 2)

            # Vẽ 4 đỉnh A, B, C, D
            cv2.putText(annotated_frame, "A", (x1 - 10, y1 - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
            cv2.putText(annotated_frame, "B", (x2 + 5, y1 - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
            cv2.putText(annotated_frame, "C", (x2 + 5, y2 + 15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
            cv2.putText(annotated_frame, "D", (x1 - 10, y2 + 15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

            # Nhãn thông số
            cv2.putText(annotated_frame, label, (x1, max(20, y1 - 10)),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

        else:  # Đánh dấu vật thể môi trường xung quanh
            cid = item['class_id']
            sc = item['score']
            if cid < len(CLASSES):
                obj_name = CLASSES[cid]
                obj_color = [int(c) for c in COLORS[cid]]

                cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), obj_color, 1)
                caption = f"{obj_name} {int(sc * 100)}%"
                cv2.putText(annotated_frame, caption, (x1, max(15, y1 - 5)),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.45, obj_color, 1)

    # Phát cảnh báo chớp viền đỏ nếu thực sự té ngã dưới sàn
    if real_fall_detected:
        cv2.rectangle(annotated_frame, (0, 0), (w_orig, h_orig), (0, 0, 255), 10)
        cv2.putText(annotated_frame, "CANH BAO: PHAT HIEN TE NGA!", (10, 35),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.imshow("Robot Patrol - Context & Fall Detection", annotated_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        is_running = False
        break

picam2.stop()
cv2.destroyAllWindows()
